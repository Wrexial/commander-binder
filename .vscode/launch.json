{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Netlify Dev (full app)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx netlify dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Server now ready on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Vite (frontend only)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
