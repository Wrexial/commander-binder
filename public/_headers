# Security & caching headers for the Netlify deploy.
#
# The CSP starts in Report-Only mode on purpose: it surfaces violations in the
# browser console without blocking Clerk's sign-in flow or telemetry yet. Once
# the production console is clean, rename the key to `Content-Security-Policy`
# to enforce it. Allowlists cover Clerk (auth + bot protection), Scryfall's API
# and image/bulk CDNs, and the self-hosted Google Fonts.

# Vite emits content-hashed filenames, so these can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must revalidate so updates reach installed clients.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The manifest and icons are stable but not hashed.
/manifest.webmanifest
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=86400

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # OAuth popups need the opener to survive the cross-origin hop.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' https://*.clerk.com https://*.clerk.accounts.dev https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://cards.scryfall.io https://*.scryfall.io https://*.clerk.com https://img.clerk.com; connect-src 'self' https://api.scryfall.com https://*.scryfall.io https://*.clerk.com https://*.clerk.accounts.dev https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com https://*.clerk.com https://*.clerk.accounts.dev; manifest-src 'self'; upgrade-insecure-requests
