# Copy to `.env` and fill in your own values. `.env` is gitignored; this example
# file is the only env file tracked. Never commit real secrets.

# Clerk publishable key — initializes Clerk on the frontend (src/auth/clerk.js).
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk issuer URL — used server-side to verify JWTs (netlify/utils/auth.ts).
VITE_CLERK_ISSUER_URL=

# Neon Postgres connection string — used by the Drizzle/Neon client (db/index.ts)
# and the `db:*` scripts (drizzle.config.ts).
NETLIFY_DATABASE_URL=
